{
  "name": "kidschurch-presenter",
  "version": "0.3.1-alpha.1",
  "type": "module",
  "private": true,
  "description": "A ProPresenter-familiar presentation application for Kids Church.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run check:electron && npm run check:stage-server && npm run check:resources && tsc -b && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "check:electron": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/stage-server.cjs && node --check electron/resource-library.cjs",
    "check:stage-server": "node scripts/test-stage-server.cjs",
    "check:resources": "node scripts/test-resource-library.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.kidschurch.presenter",
    "productName": "KidsChurch Presenter",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KidsChurch-Presenter-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "artifactName": "KidsChurch-Presenter-${version}.${ext}"
    }
  }
}
